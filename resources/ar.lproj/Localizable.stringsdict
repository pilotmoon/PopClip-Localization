<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lu Uses Left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@uses@</string>
		<key>uses</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>few</key>
			<string>تبقّى %lu استخدامات</string>
			<key>many</key>
			<string>تبقّى %lu استخدامًا</string>
			<key>one</key>
			<string>تبقّى استخدام واحد</string>
			<key>other</key>
			<string>تبقّى %lu استخدام</string>
			<key>two</key>
			<string>تبقّى استخدامان</string>
			<key>zero</key>
			<string>لم يتبقَّ أي استخدام</string>
		</dict>
	</dict>
	<key>%lu extensions updated</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>few</key>
			<string>تم تحديث %lu إضافات</string>
			<key>many</key>
			<string>تم تحديث %lu إضافةً</string>
			<key>one</key>
			<string>تم تحديث إضافة واحدة</string>
			<key>other</key>
			<string>تم تحديث %lu إضافة</string>
			<key>two</key>
			<string>تم تحديث إضافتين</string>
			<key>zero</key>
			<string>لم تُحدَّث أي إضافة</string>
		</dict>
	</dict>
	<key>%lu instances</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>few</key>
			<string>%lu نسخ</string>
			<key>many</key>
			<string>%lu نسخةً</string>
			<key>one</key>
			<string>نسخة واحدة</string>
			<key>other</key>
			<string>%lu نسخة</string>
			<key>two</key>
			<string>نسختان</string>
			<key>zero</key>
			<string>لا توجد نسخ</string>
		</dict>
	</dict>
	<key>%lu updates available</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>few</key>
			<string>يتوفر %lu تحديثات</string>
			<key>many</key>
			<string>يتوفر %lu تحديثًا</string>
			<key>one</key>
			<string>يتوفر تحديث واحد</string>
			<key>other</key>
			<string>يتوفر %lu تحديث</string>
			<key>two</key>
			<string>يتوفر تحديثان</string>
			<key>zero</key>
			<string>لا توجد تحديثات متاحة</string>
		</dict>
	</dict>
</dict>
</plist>
